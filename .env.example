# Bu faylni .env nomi bilan nusxalab, o'z qiymatlaringizni kiriting.
# Diqqat: tokenni hech qachon GitHub'ga yoki ochiq joyga yuklamang!

BOT_TOKEN=YANGI_TOKENINGIZNI_BU_YERGA_QOYING
ADMIN_ID=8083111569
WEBAPP_URL=https://username.github.io/stars-webapp/

# ---- Mini-app profil qidiruv API'si (api_server.py) ----
# Bot ishlaydigan serverning tashqi (https) manzili. Bu bilan mini-app
# "@username kim ekan" deb so'raydi. Domeningiz bo'lmasa, Cloudflare Tunnel
# yoki shunga o'xshash bepul xizmat orqali https manzil olishingiz mumkin.
API_PORT=8080
API_BASE_URL=https://sizning-domeningiz.com

# ---- Fragment.com avtomatik yuborish (ixtiyoriy, xavfli - README.md ni o'qing!) ----
# Yoqish uchun: true. O'chirilgan bo'lsa (false), admin har doim qo'lda yuboradi.
FRAGMENT_AUTO_SEND=false
# Faqat shu bot uchun ALOHIDA, kichik mablag'li hamyon seed-phrase'i:
FRAGMENT_SEED=
# tonconsole.com dan olinadigan API kalit:
FRAGMENT_API_KEY=
# fragment.com ga TON hamyon ulab kirgandan so'ng brauzerdan olinadigan cookie'lar (JSON):
FRAGMENT_COOKIES={"stel_ssid":"","stel_dt":"","stel_token":"","stel_ton_token":""}
